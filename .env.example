# Database (Railway PostgreSQL - use the existing DATABASE_URL from your Railway Postgres service)
DATABASE_URL=

# Trainerize API
TRAINERIZE_GROUP_ID=
TRAINERIZE_API_TOKEN=
TRAINERIZE_WEBHOOK_KEY=

# Typeform
TYPEFORM_PERSONAL_ACCESS_TOKEN=

# Oura (update OURA_REDIRECT_URI to production URL when deploying)
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=https://dashboard.myfitcoach.ie/api/connect/oura/callback

# Scheduler
# Must be exactly "true" for the portal to send anything automatically:
# scheduled messages, group posts, check-in reminders, client reconciliation
# and the nightly backup. Anything else, including leaving it unset, means the
# server starts but sends nothing.
#
# On the LIVE Railway service this must be true.
# On a laptop leave it unset - .env points at the live database, so a second
# instance with this on can send a client the same message twice.
SCHEDULER_ENABLED=

# Server
PORT=3001
SESSION_SECRET=
